# =============================================================================
# AYUSAARTHI APP — Environment Variables Template
# Copy this file to .env.local and populate with your own credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# QDRANT CLOUD (Vector Database)
# -----------------------------------------------------------------------------
QDRANT_URL=https://<your-cluster-id>.<region>.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
COLLECTION_NAME=ayusaarthi_chunks_v2

# -----------------------------------------------------------------------------
# EMBEDDING SERVER (Local or Remote FastAPI bge-m3)
# -----------------------------------------------------------------------------
EMBEDDING_API_URL=http://localhost:8001/v1/embeddings
EMBEDDING_API_KEY=local
EMBEDDING_MODEL=BAAI/bge-m3

# -----------------------------------------------------------------------------
# LLM INFERENCE (NVIDIA NIM / OpenRouter / Gemini)
# -----------------------------------------------------------------------------
# Primary: NVIDIA NIM
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_FAST_MODELS=openai/gpt-oss-20b

# Alternative: OpenRouter (optional fallback)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Alternative: Google Gemini (optional fallback)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# RAG TUNING PARAMETERS
# -----------------------------------------------------------------------------
RAG_REASONING=medium
RAG_RETRIEVAL_TOP_K=20
RAG_FINAL_TOP_K=6
RAG_MIN_SCORE=0
